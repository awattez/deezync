# Elasticsearch connection
ES_URL=https://my-deployment.es.europe-west1.gcp.cloud.es.io:443
ES_API_KEY=

# Alternative to ES_API_KEY
# ES_USERNAME=elastic
# ES_PASSWORD=

# Destination index
ES_INDEX=deezer-history

# File listing the Deezer accounts (default: users.toml)
# DEEZYNC_USERS_FILE=users.toml
